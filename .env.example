# Node 24+; no credentials are needed for the deterministic demo provider.
HOST=127.0.0.1
PORT=4318
DATABASE_PATH=./data/waypoint.sqlite
# Only demo is implemented. Unsupported values fail at startup.
SEO_PROVIDER=demo
# Claude powers AI recommendations. Set this only in your ignored local .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional native public YouTube discovery.
YOUTUBE_API_KEY=
# Native lifetime post pulls. Obtain authorized tokens through each provider.
# Pin versions supported by your registered apps (do not include angle brackets).
META_GRAPH_VERSION=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
# open_id returned by TikTok OAuth; prevents mixing different accounts' video IDs.
TIKTOK_OPEN_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Supported Marketing API version, YYYYMM.
LINKEDIN_VERSION=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
X_BEARER_TOKEN=
X_USER_ID=
PINTEREST_ACCESS_TOKEN=
# Stable username/account identifier matching the authorized Pinterest account.
PINTEREST_ACCOUNT=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
