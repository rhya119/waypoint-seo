# Node 24+; public website scans and CSV imports need no provider credentials.
HOST=127.0.0.1
PORT=4318
DATABASE_PATH=./data/waypoint.sqlite
# Legacy example API provider only; normal web UI/MCP use actual scans and data.
SEO_PROVIDER=demo
# Claude powers AI recommendations. Set this only in your ignored local .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional native public YouTube discovery.
YOUTUBE_API_KEY=
# Native lifetime post pulls. Obtain authorized tokens through each provider.
# Pin versions supported by your registered apps (do not include angle brackets).
META_GRAPH_VERSION=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
# open_id returned by TikTok OAuth; prevents mixing different accounts' video IDs.
TIKTOK_OPEN_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Supported Marketing API version, YYYYMM.
LINKEDIN_VERSION=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
X_BEARER_TOKEN=
X_USER_ID=
PINTEREST_ACCESS_TOKEN=
# Stable username/account identifier matching the authorized Pinterest account.
PINTEREST_ACCOUNT=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Recommended: "Sign in with Google" for Search Console + GA4 (read-only, auto-renewing).
# console.cloud.google.com → APIs & Services → enable "Google Search Console API",
# "Google Analytics Data API" and "Google Analytics Admin API" → OAuth consent screen
# (External, add yourself as a test user) → Credentials → Create OAuth client ID →
# Application type "Desktop app". Paste the ID and secret here and restart Waypoint.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alternative: a manually obtained OAuth access token (expires after about an hour).
# Scopes: https://www.googleapis.com/auth/webmasters.readonly
#         https://www.googleapis.com/auth/analytics.readonly
# Access tokens expire; no automatic login or token refresh is implemented.
GOOGLE_SEO_ACCESS_TOKEN=
# Optional GA4 property ID (digits only) and exact matching website domain.
GA4_PROPERTY_ID=
GA4_SITE_DOMAIN=
# Optional PAID traffic estimates; requires Similarweb API entitlement.
# Requests happen only through the explicit Fetch traffic estimates action.
SIMILARWEB_API_KEY=

# Optional free Google PageSpeed Insights key (console.cloud.google.com → enable
# "PageSpeed Insights API" → Credentials → API key). Speed tests work without it
# at a small shared quota; a key gives you your own daily quota.
PAGESPEED_API_KEY=
