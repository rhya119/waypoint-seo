{
  "name": "waypoint-seo", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0",
    "express": "^5.1.0", "zod": "^4.1.0", "cheerio": "^1.1.2", "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/express": "^5.0.3",
    "@types/node": "^24.0.0", "@types/supertest": "^6.0.3", "supertest": "^7.1.4",
    "@vitejs/plugin-react": "^5.0.0", "vite": "^7.1.0", "typescript": "^5.9.0",
    "tsx": "^4.20.0", "concurrently": "^9.2.0"
  }
}
